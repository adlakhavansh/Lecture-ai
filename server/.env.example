# Copy this file to .env and fill in your own keys — never commit .env
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001

# Optional. Defaults to gemini-2.0-flash.
# GEMINI_MODEL is used for the end-of-lecture summary; GEMINI_LIVE_MODEL for the
# 75s live insight loop (falls back to GEMINI_MODEL if unset). Split them if you
# want a cheaper/faster model driving the live panel.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_LIVE_MODEL=gemini-3.6-flash
